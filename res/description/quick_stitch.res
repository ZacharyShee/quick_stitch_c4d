CONTAINER quick_stitch
{
    NAME quick_stitch;
    INCLUDE Obase;
    GROUP ID_OBJECTPROPERTIES
    {
        BUTTON QUICK_STITCH_BUTTON {}
        LINK QUICK_STITCH_SOURCE { ACCEPT { Obase; } }
        GROUP QUICK_STITCH_GROUP_LAYOUT
        {
            DEFAULT 1;
            LONG QUICK_STITCH_STYLE
            {
                CYCLE
                {
                    QUICK_STITCH_STYLE_ORIGINAL;
                    QUICK_STITCH_STYLE_RUNNING;
                    QUICK_STITCH_STYLE_DOUBLE;
                    QUICK_STITCH_STYLE_SLANT;
                    QUICK_STITCH_STYLE_ZIGZAG;
                    QUICK_STITCH_STYLE_CHEVRON;
                    QUICK_STITCH_STYLE_CROSS;
                    QUICK_STITCH_STYLE_DIAMOND;
                    QUICK_STITCH_STYLE_BRAID;
                }
            }
            LONG QUICK_STITCH_DISTRIBUTION
            {
                CYCLE { QUICK_STITCH_MODE_COUNT; QUICK_STITCH_MODE_PITCH; }
            }
            LONG QUICK_STITCH_COUNT { MIN 0; MINSLIDER 1; MAXSLIDER 500; CUSTOMGUI LONGSLIDER; SCALE_H; }
            REAL QUICK_STITCH_PITCH { UNIT METER; MIN 0.001; }
            REAL QUICK_STITCH_THICKNESS { UNIT METER; MIN 0; }
            REAL QUICK_STITCH_PHASE { UNIT PERCENT; MIN 0; MAX 100; MINSLIDER 0; MAXSLIDER 100; STEP 1; CUSTOMGUI REALSLIDER; SCALE_H; }
            BOOL QUICK_STITCH_MIRROR {}
            BOOL QUICK_STITCH_REVERSE {}
        }
        GROUP QUICK_STITCH_GROUP_ORIGINAL
        {
            REAL QUICK_STITCH_WIDTH { UNIT METER; }
            REAL QUICK_STITCH_HEIGHT { UNIT METER; }
            REAL QUICK_STITCH_OFFSET { UNIT METER; }
            SPLINE QUICK_STITCH_SHAPE {}
        }
        GROUP QUICK_STITCH_GROUP_PATTERN
        {
            DEFAULT 1;
            REAL QUICK_STITCH_SEAM_WIDTH { UNIT METER; MIN 0; }
            REAL QUICK_STITCH_STITCH_LENGTH { UNIT METER; MIN 0.001; }
            REAL QUICK_STITCH_CROSS_CLEARANCE { UNIT METER; MIN 0; }
            REAL QUICK_STITCH_LEAN { UNIT PERCENT; MIN 5; MAX 95; MINSLIDER 5; MAXSLIDER 95; STEP 1; CUSTOMGUI REALSLIDER; SCALE_H; }
        }
        GROUP QUICK_STITCH_GROUP_NEEDLE
        {
            DEFAULT 1;
            LONG QUICK_STITCH_SHAPE_PRESET
            {
                CYCLE { QUICK_STITCH_PRESET_ORIGINAL; QUICK_STITCH_PRESET_ROUND;
                        QUICK_STITCH_PRESET_LOW; QUICK_STITCH_PRESET_STRAIGHT;
                        QUICK_STITCH_PRESET_CUSTOM; }
            }
            SPLINE QUICK_STITCH_NEEDLE_SHAPE {}
            REAL QUICK_STITCH_ARCH { UNIT METER; MIN 0; }
            REAL QUICK_STITCH_SURFACE_OFFSET { UNIT METER; }
        }
        GROUP QUICK_STITCH_GROUP_SURFACE
        {
            DEFAULT 1;
            BOOL QUICK_STITCH_CONFORM {}
            LINK QUICK_STITCH_SURFACE { ACCEPT { Obase; } }
            REAL QUICK_STITCH_RAY_DISTANCE { UNIT METER; MIN 0.001; }
            BOOL QUICK_STITCH_FLIP_NORMAL {}
            LONG QUICK_STITCH_UP_AXIS
            {
                CYCLE { QUICK_STITCH_AXIS_Y; QUICK_STITCH_AXIS_Z; QUICK_STITCH_AXIS_X;
                        QUICK_STITCH_AXIS_NY; QUICK_STITCH_AXIS_NZ; QUICK_STITCH_AXIS_NX; }
            }
            REAL QUICK_STITCH_ROTATION_H { UNIT DEGREE; MIN -180; MAX 180; CUSTOMGUI REALSLIDER; SCALE_H; }
            REAL QUICK_STITCH_ROTATION_P { UNIT DEGREE; MIN -180; MAX 180; CUSTOMGUI REALSLIDER; SCALE_H; }
            REAL QUICK_STITCH_ROTATION_B { UNIT DEGREE; MIN -180; MAX 180; CUSTOMGUI REALSLIDER; SCALE_H; }
        }
        GROUP QUICK_STITCH_GROUP_MATERIAL
        {
            LINK QUICK_STITCH_MATERIAL_A { ACCEPT { Mbase; } }
            LINK QUICK_STITCH_MATERIAL_B { ACCEPT { Mbase; } }
            LINK QUICK_STITCH_MATERIAL_C { ACCEPT { Mbase; } }
            COLOR QUICK_STITCH_COLOR_A {}
            COLOR QUICK_STITCH_COLOR_B {}
            COLOR QUICK_STITCH_COLOR_C {}
        }
        GROUP QUICK_STITCH_GROUP_QUALITY
        {
            LONG QUICK_STITCH_DETAIL { MIN 4; MAX 48; }
            LONG QUICK_STITCH_PROFILE_STEPS { MIN 1; MAX 32; }
        }
    }
    GROUP QUICK_STITCH_GROUP_ABOUT
    {
        LONG QUICK_STITCH_LANGUAGE
        {
            ANIM OFF;
            CYCLE
            {
                QUICK_STITCH_LANG_AUTO;
                QUICK_STITCH_LANG_EN;
                QUICK_STITCH_LANG_ZH;
            }
        }
        SEPARATOR { LINE; }
        STATICTEXT QUICK_STITCH_INFO_PLUGIN { ANIM OFF; }
        STATICTEXT QUICK_STITCH_INFO_VERSION { ANIM OFF; }
        STATICTEXT QUICK_STITCH_INFO_AUTHOR { ANIM OFF; }
        STATICTEXT QUICK_STITCH_INFO_ORIGINAL { ANIM OFF; }
    }
}
